{
  "expo": {
    "name": "Naviz",
    "slug": "naviz",
    "version": "0.2.1",
    "orientation": "portrait",
    "scheme": "naviz",
    "userInterfaceStyle": "light",
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Naviz uses your location to guide you while a route is active.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-splash-screen"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.naviz.mobile",
      "buildNumber": "3",
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ],
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "app.naviz.mobile",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#111827"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a8395eb1-cc48-4b72-9abc-2822cdedd5a4"
      }
    },
    "owner": "shaharblank"
  }
}
